# Confirmed target. Generate private credentials with prepare.py on the VPS.
# Existing Nginx owns 80/443: apply compose.nginx.yaml after compose.yaml.
DOMAIN=relivo-desk.duckdns.org
PUBLIC_ORIGIN=https://relivo-desk.duckdns.org
RELAY_URL=wss://relivo-desk.duckdns.org/ws/relay
IMAGE_TAG=2026-11-11.2
RUNTIME_DIR=./runtime
PUBLIC_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
NAT_PORT=21115
ID_PORT=21116
# Used only by compose.nginx.yaml; the binding is always 127.0.0.1.
PROXY_PORT=18083
