#!/usr/bin/env python3
"""Start the packaged Linux agent or provision its unique enrollment credential."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import re
import sys
import tempfile
import tomllib

from configure import options_from_profile


def private_path(path):
    if any(part.is_symlink() for part in [path, *path.parents]):
        raise ValueError("Refusing a symlink in the profile path")
    if path.exists() and path.stat().st_uid != os.getuid():
        raise ValueError("The profile must belong to the current user")


def save_private(path, content):
    private_path(path)
    with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, delete=False) as stream:
        temporary = Path(stream.name)
        try:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
            os.replace(temporary, path)
        finally:
            temporary.unlink(missing_ok=True)


def provision(path, expected, credential):
    private_path(path)
    if not path.exists():
        options = dict(expected)
        if credential:
            options["management-device-token"] = credential
        save_private(path, "[options]\n" + "".join(
            f"{key} = {json.dumps(value)}\n" for key, value in options.items()))
        return
    original = path.read_text()
    parsed = tomllib.loads(original)
    if any(parsed.get("options", {}).get(key) != value for key, value in expected.items()):
        raise ValueError("Existing profile does not match the managed Relivo server settings")
    if not credential:
        return
    section = re.search(r"(?m)^\[options\][ \t]*\n", original)
    if section is None:
        raise ValueError("Unsupported options layout; the profile was not changed")
    next_section = re.search(r"(?m)^\[", original[section.end():])
    end = section.end() + next_section.start() if next_section else len(original)
    options_text = original[section.end():end]
    entry = f'management-device-token = "{credential}"\n'
    options_text, count = re.subn(r"(?m)^management-device-token\s*=.*(?:\n|$)", entry, options_text)
    if count == 0:
        options_text = entry + options_text
    updated = original[:section.end()] + options_text + original[end:]
    parsed["options"]["management-device-token"] = credential
    if tomllib.loads(updated) != parsed:
        raise ValueError("Credential update would change other settings; the profile was not changed")
    save_private(path, updated)


def main():
    parser = argparse.ArgumentParser(description=__doc__, add_help=False)
    parser.add_argument("--enrollment-file", type=Path)
    parser.add_argument("--prepare-only", action="store_true")
    parser.add_argument("--launcher-help", action="help")
    args, native_args = parser.parse_known_args()
    os.umask(0o077)
    bundle = Path(__file__).resolve().parent
    profile = Path(os.environ.get("RELIVO_PROFILE_DIR", str(Path.home() / ".local/share/relivo-agent"))).absolute()
    private_path(profile)
    profile.mkdir(parents=True, mode=0o700, exist_ok=True)
    lock_path = profile / "profile.lock"
    private_path(lock_path)
    with lock_path.open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            if args.enrollment_file or args.prepare_only:
                raise ValueError("Close all instances of this Relivo Agent before provisioning")
            fcntl.flock(lock, fcntl.LOCK_SH)
            # A running launcher already initialized and validated this profile.
        else:
            server = json.loads((bundle / "server-profile.json").read_text())
            credential = args.enrollment_file.read_text().strip() if args.enrollment_file else None
            expected = options_from_profile(server, credential)
            expected.pop("management-device-token", None)
            for directory in ("config/rustdesk", "cache", "data"):
                target = profile / directory
                private_path(target)
                target.mkdir(parents=True, mode=0o700, exist_ok=True)
            provision(profile / "config/rustdesk/RustDesk2.toml", expected, credential)
            local = profile / "config/rustdesk/RustDesk_local.toml"
            private_path(local)
            if not local.exists():
                save_private(local, '[options]\nenable-check-update = "N"\n')
            if args.enrollment_file or args.prepare_only:
                print("Relivo profile prepared. Device approval remains a separate console action.")
                return
            fcntl.flock(lock, fcntl.LOCK_SH)
        os.environ.update({
            "XDG_CONFIG_HOME": str(profile / "config"),
            "XDG_CACHE_HOME": str(profile / "cache"),
            "XDG_DATA_HOME": str(profile / "data"),
            "LD_LIBRARY_PATH": str(bundle / "native/lib") + (
                ":" + os.environ["LD_LIBRARY_PATH"] if os.environ.get("LD_LIBRARY_PATH") else ""),
        })
        os.set_inheritable(lock.fileno(), True)
        executable = bundle / "native/rustdesk"
        os.execv(executable, [str(executable), *native_args])


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, TypeError) as error:
        print(f"Relivo Agent could not start: {error}", file=sys.stderr)
        sys.exit(1)
