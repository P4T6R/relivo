# Public HTTPS origin, without a trailing slash; HTTP is allowed only on loopback.
MANAGEMENT_ORIGIN=https://relivo-desk.duckdns.org
MANAGEMENT_LISTEN=127.0.0.1:21114
MANAGEMENT_INTERNAL_LISTEN=127.0.0.1:21120
MANAGEMENT_DATABASE=/var/lib/rustdesk-management/management.sqlite3
MANAGEMENT_INTERNAL_KEY_FILE=/etc/rustdesk-management/internal-key
MANAGEMENT_WEB_DIR=/opt/rustdesk-management/web

# Set these on both modified hbbs and hbbr processes.
MANAGEMENT_URL=http://127.0.0.1:21120
MANAGEMENT_RELAY_URL=wss://relivo-desk.duckdns.org/ws/relay
