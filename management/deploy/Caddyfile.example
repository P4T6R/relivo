support.example.com {
    header Strict-Transport-Security "max-age=31536000"
    @rendezvous path /ws/id
    reverse_proxy @rendezvous 127.0.0.1:21118 {
        header_up X-Real-IP {remote_host}
    }
    @relay path /ws/relay
    reverse_proxy @relay 127.0.0.1:21119 {
        header_up X-Real-IP {remote_host}
    }
    reverse_proxy 127.0.0.1:21114
}
